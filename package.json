{
  "name": "zotero-scipdf-enhanced",
  "version": "8.1.3.8",
  "description": "Enhanced PDF retrieval for Zotero with mirror management and manual verification",
  "config": {
    "addonName": "Sci-PDF Enhanced",
    "addonID": "scipdf@ytshen.com",
    "addonRef": "scipdf",
    "addonInstance": "scipdf",
    "prefsPrefix": "extensions.zotero.scipdf"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom3410/zotero-scipdf-enhanced.git"
  },
  "author": "syt2",
  "bugs": {
    "url": "https://github.com/tom3410/zotero-scipdf-enhanced/issues"
  },
  "homepage": "https://github.com/tom3410/zotero-scipdf-enhanced#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "npm run test:unit && zotero-plugin test",
    "test:unit": "node --test test/*.test.cjs",
    "update-deps": "npm update --save",
    "test:package": "node --test test/packaging.check.cjs"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "contributors": [
    {
      "name": "tom3410",
      "url": "https://github.com/tom3410"
    }
  ]
}
