pref-title = PDF Download Settings
pref-autoDownload =
    .label = Download PDFs automatically
pref-scihub-input = Sci-Hub URL list
pref-url-help = One URL per line. Scroll or drag the bottom edge to resize. Commas and semicolons also work. Changes save on blur; duplicates are removed and DOI placeholders added.
pref-save = Save URL list
pref-source-title = Update URLs from a page
pref-source-label = Source page URL
pref-source-help = Extract Sci-Hub homepages from page links and text, then merge without duplicates. Other domains with links labelled Sci-Hub are supported. The source must contain the URLs directly; page scripts are not run. Availability and freshness are not verified.
pref-fetch = Fetch and add URLs
pref-auto-update =
    .label = Fetch on Zotero startup (at most once per 24 hours)
pref-last-update = Last successful fetch: { $time }
pref-never-updated = No successful fetch yet
pref-invalid-urls = Invalid URLs; nothing saved. Please check: { $urls }
pref-invalid-source = Enter a valid http:// or https:// source page URL.
pref-saved = Saved { $count } URLs.
pref-fetching = Fetching URLs…
pref-fetch-success = Added { $added } URLs; { $total } total. Existing URLs were retained.
pref-fetch-failed = Fetch failed; existing URLs were retained. Check that the source is reachable and directly contains Sci-Hub homepage links. Details: { $error }
pref-source-changed = Source page changed. Please fetch again.
pref-help = { $name } Build { $version }

pref-interactive-download =
    .label = Open a manual window for verification, redirects or unrecognized pages
